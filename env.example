# Example environment variables for OpenCode Docker setup
# Replace the placeholder values with your actual secrets.

# Cloudflare Tunnel token (required for the cloudflared container)
CLOUDFLARED_TUNNEL_TOKEN=YOUR_CLOUDFLARED_TUNNEL_TOKEN

# OpenCode API key (if required by the image)
OPENCODE_API_KEY=YOUR_OPENCODE_API_KEY

# GitHub Container Registry token for pulling the image (PAT with read:packages scope)
GHCR_TOKEN=YOUR_GHCR_PAT_TOKEN   # <-- keep this as a PAT, NOT a repo URL

# GitHub username for GHCR login (optional)
GHCR_USERNAME=YOUR_GITHUB_USERNAME

# UID and GID for the non‑root user that will run OpenCode inside the container
USER_ID=1000
GROUP_ID=1000

# SSH private key for accessing private GitHub repositories (path on host)
GITHUB_SSH_KEY=~/.ssh/id_rsa

# Repository to clone before starting OpenCode (ssh URL)
GIT_REPO_URL=git@github.com:ozgurumyilmazim/infra-identity-gateway.git

# Local directory (relative to project root) where the repo will be cloned
# You can change this if you prefer a different name.
REPO_DIR=workspace

OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change_this_to_a_strong_password_123!

# Evren LLM Bağlantı Parametreleri
OPENAI_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
OPENAI_API_KEY=evren_llm_xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=deepseek-v4.1-flash
