# Ignore secret environment file
.env

# Ignore ienv file (if present)
ienv

# Ignore workspace directory (Docker volume / bind mount)
workspace/

# Ignore OpenCode data directory (mounted for .local)
opencode_data/

# Docker artifacts
Dockerfile
docker-compose.override.yml

# OS generated files
.DS_Store
Thumbs.db

# Bash scripts generated by tooling (if any)
*.sh

# Allow custom scripts folder
!scripts/*.sh

# IDE/editor files
*.code-workspace
.vscode/
.idea/

# Node / Python caches (if later added)
node_modules/
__pycache__/